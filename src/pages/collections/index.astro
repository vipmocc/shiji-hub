---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { getCollection } from 'astro:content';

const collections = await getCollection('collections');
---

<BaseLayout
  title={`专题合集 — ${site.name}`}
  description="围绕具体场景的精选合集：AI 编程工具、免费生产力工具、开源 AI 模型与学习路线。"
>
  <div class="container">
    <div class="page-lead">
      <span class="eyebrow">COLLECTIONS</span>
      <h1>专题合集</h1>
      <p>按场景打包的精选清单，每个合集都回答一个具体问题。</p>
    </div>
    <div class="col-grid" style="padding-bottom:60px;">
      {
        collections.map((c, i) => (
          <a class="col-card" href={`/collections/${c.id}/`}>
            <span class="col-no">NO.{String(i + 1).padStart(2, '0')}</span>
            <h2>{c.data.title}</h2>
            <p>{c.data.description}</p>
            <span class="count">{c.data.resources.length} 个资源 →</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

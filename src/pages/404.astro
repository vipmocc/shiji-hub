---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title={`页面不存在 — ${site.name}`} description="页面不存在">
  <div class="container">
    <div class="page-wrap" style="text-align:center;padding-top:110px;">
      <span class="eyebrow">404</span>
      <h1 style="font-size:clamp(40px,7vw,64px);margin:14px 0;">这个页面走丢了</h1>
      <p class="muted" style="margin-bottom:30px;">它可能已被移除，或者从未存在过。</p>
      <a class="btn-primary" href="/">回到首页</a>
    </div>
  </div>
</BaseLayout>
